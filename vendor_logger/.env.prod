# vendor-logger — PROD runtime configuration (ap-south-1)
# Read by docker-compose.prod.yml (env_file). NON-SECRET values only.
#
# Secrets (SQS URL + hash salts) are NOT set here — Jenkinsfile-prod writes them to
# .env.secrets on the host from Jenkins credentials, and docker-compose.prod.yml
# loads .env.secrets too. Never commit filled-in secrets.

# --- Service config (non-secret) ---
NODE_ENV=prod
PORT=3013
SERVICE_NAME=vendor-logger-svc

# --- AWS ---
# Must match the prod SQS queue's region (prod is ap-south-1). app.module.ts reads
# AWS_REGION for sqsRegion; the AWS SDK uses it for the SQS client too.
AWS_REGION=ap-south-1

# --- Secrets: injected at deploy time via .env.secrets (see Jenkinsfile-prod) ---
#   VENDOR_ARCHIVE_SQS_URL   Jenkins credential: vl-prod-sqs-url
#   MOBILE_HASH_SALT         AWS Secrets Manager: vendor-archive-prod/vendor-logger/mobile-hash-salt
#   AADHAAR_HASH_SALT        AWS Secrets Manager: vendor-archive-prod/vendor-logger/aadhaar-hash-salt
# The salts are read on the host by the vendor-logger-svc role (single source of
# truth = Secrets Manager, Terraform-managed); they never pass through Jenkins.
