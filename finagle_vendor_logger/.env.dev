# finagle-vendor-logger — dev runtime configuration (ap-south-2 / staging)
# Read by docker-compose-dev.yml (env_file: .env.dev) on the EC2 host. NON-SECRET only.
#
# Secrets + the SQS URL are NOT set here — Jenkinsfile-dev writes them to .env.secrets
# on the host, and docker-compose-dev.yml loads .env.secrets too. Never commit secrets.

# --- Service config (non-secret) ---
NODE_ENV=dev
PORT=3013
SERVICE_NAME=vendor-logger-svc

# --- AWS ---
# Region of the SQS queue (dev/staging is ap-south-2). app.module.ts reads AWS_REGION.
AWS_REGION=ap-south-2

# --- Injected at deploy time via .env.secrets (see Jenkinsfile-dev) ---
#   VENDOR_ARCHIVE_SQS_URL   from the Jenkinsfile-dev env (non-secret)
#   MOBILE_HASH_SALT         AWS Secrets Manager: vendor-archive-staging/vendor-logger/mobile-hash-salt
#   AADHAAR_HASH_SALT        AWS Secrets Manager: vendor-archive-staging/vendor-logger/aadhaar-hash-salt
# The salts are fetched from Secrets Manager by Jenkins at deploy time (single source
# of truth); they are never stored as Jenkins string credentials.
